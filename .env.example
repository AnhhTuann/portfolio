# ============================================================
# Portfolio - Production Environment Variables
# Copy file này thành .env và điền giá trị thực
# ============================================================

# PostgreSQL password (bắt buộc)
POSTGRES_PASSWORD=change_me_strong_password_here

# JWT Secret (bắt buộc - đổi thành chuỗi random dài)
JWT_SECRET=change_me_very_long_random_secret_here

# Port backend (mặc định 5000, Nginx sẽ proxy)
PORT=5000
